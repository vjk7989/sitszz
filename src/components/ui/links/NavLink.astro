---
// Destructure the properties from Astro.props
const { url, name } = Astro.props;

const normalizePath = (path: string) => {
  const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
  const withoutBase =
    basePath && (path === basePath || path.startsWith(`${basePath}/`))
      ? path.slice(basePath.length) || '/'
      : path;
  return withoutBase.replace(/\/$/, '') || '/';
};

const isCurrentPage = normalizePath(Astro.url.pathname) === normalizePath(url);
const characters = Array.from(name);

// Define TypeScript interface for the properties
interface Props {
  url: string;
  name: string;
}
---

{/*
Re-usable link component for navigation bar. The current-page state is
calculated during rendering, so it works on every static route, locale, and
GitHub Pages base path without relying on a browser-side path comparison.
*/}
<a
  href={url}
  data-astro-prefetch
  class:list={[
    isCurrentPage ? 'theme-nav-link-active' : 'theme-nav-link',
    'theme-nav-link-motion rounded-lg text-base font-medium ring-zinc-500 outline-hidden focus-visible:ring-3 md:py-3 md:text-sm 2xl:text-base dark:ring-zinc-200 dark:focus:outline-hidden',
  ]}
  aria-label={name}
  aria-current={isCurrentPage ? 'page' : undefined}
>
  <span class="theme-nav-roll" aria-hidden="true">
    {characters.map((character, index) =>
      character === ' ' ? (
        <span class="theme-nav-roll-space">&nbsp;</span>
      ) : (
        <span
          class="theme-nav-roll-character"
          style={`--nav-roll-index: ${index}`}
        >
          <span class="theme-nav-roll-glyphs">
            <span>{character}</span>
            <span>{character}</span>
          </span>
        </span>
      )
    )}
  </span>
</a>
