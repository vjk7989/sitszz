---
import Icon from '@components/ui/icons/Icon.astro';

const { title = Astro.locals.copy.auth.logIn } = Astro.props;

interface Props {
  title?: string;
}

const baseClasses =
  'theme-nav-link flex items-center gap-x-2 text-base md:text-sm font-medium ring-zinc-500 transition duration-300 focus-visible:ring-3 outline-hidden';
const hoverClasses = '';
const darkClasses = 'dark:ring-zinc-200 dark:focus:outline-hidden';
const mdClasses = 'theme-nav-divider md:my-6 md:border-s md:ps-6';
const txtSizeClasses = '2xl:text-base';
---

<button
  type="button"
  class={`${baseClasses} ${hoverClasses} ${darkClasses} ${mdClasses} ${txtSizeClasses}`}
  data-hs-overlay="#hs-toggle-between-modals-login-modal"
>
  <Icon name="user" class="h-4 w-4 shrink-0" />
  {title}
</button>
