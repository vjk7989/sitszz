---
// Destructure the properties from Astro.props
const { title, url } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  title?: string;
  url?: string;
}
// Define CSS classes for the hyperlink button
const baseClasses =
  'theme-button-secondary inline-flex items-center justify-center gap-x-2 rounded-lg px-4 py-3 text-center text-sm font-medium shadow-xs outline-hidden ring-zinc-500 focus-visible:ring-3 transition duration-300';
const borderClasses = 'border';
const bgColorClasses = '';
const hoverClasses =
  '';
const disableClasses = 'disabled:pointer-events-none disabled:opacity-50';
const fontSizeClasses = '2xl:text-base';
const ringClasses = 'ring-zinc-500';

const darkClasses = 'dark:ring-zinc-200 dark:focus:outline-hidden';
---

{/* Styled hyperlink */}
<a
  class={`${baseClasses} ${borderClasses} ${bgColorClasses} ${hoverClasses} ${disableClasses} ${fontSizeClasses} ${ringClasses} ${darkClasses}`}
  href={url}
>
  {title}
</a>
