---
const sources = [
  { name: 'User input', mark: 'U' },
  { name: 'Tool calls', mark: 'T' },
  { name: 'Agent operations', mark: 'A' },
  { name: 'Automations', mark: '∞' },
];

const threats = [
  { name: 'Prompt injection', placement: 'prompt' },
  { name: 'Supply-chain attack', placement: 'supply' },
  { name: 'Agentic attack', placement: 'agentic' },
];
---

<div class="security-flow" role="img" aria-labelledby="security-flow-title security-flow-description">
  <span id="security-flow-title" class="sr-only">Signed audit security flow</span>
  <span id="security-flow-description" class="sr-only">
    User input, tool calls, agent operations, and automations pass through a signed audit ledger before reaching a protected application. Prompt injection, supply-chain, and agentic attacks are rejected at the ledger.
  </span>

  <div class="security-flow-grid" aria-hidden="true"></div>
  <p class="security-flow-note" aria-hidden="true">Every action is checked before it moves on.</p>

  <svg class="security-flow-lines" viewBox="0 0 900 600" preserveAspectRatio="none" aria-hidden="true">
    <path class="line line-safe" d="M 180 178 C 302 178, 354 245, 425 285" />
    <path class="line line-safe" d="M 180 267 C 310 267, 353 290, 425 298" />
    <path class="line line-safe" d="M 180 355 C 306 355, 355 320, 425 307" />
    <path class="line line-safe" d="M 180 444 C 300 444, 355 370, 425 320" />
    <path class="line line-output" d="M 550 303 C 648 303, 674 303, 758 303" />
    <path class="line line-threat" d="M 392 77 C 430 132, 455 185, 468 238" />
    <path class="line line-threat" d="M 715 89 C 642 145, 580 200, 530 250" />
    <path class="line line-threat" d="M 490 534 C 500 454, 505 388, 503 356" />
    <path class="break-mark" d="M 462 242 l 14 12 m -14 0 l 14 -12" />
    <path class="break-mark" d="M 522 251 l 14 12 m -14 0 l 14 -12" />
    <path class="break-mark" d="M 497 349 l 14 12 m -14 0 l 14 -12" />
  </svg>

  <div class="security-flow-sources" aria-hidden="true">
    {sources.map(source => (
      <div class="security-flow-source">
        <span class="security-flow-source-mark">{source.mark}</span>
        <span>{source.name}</span>
      </div>
    ))}
  </div>

  <div class="security-flow-ledger" aria-hidden="true">
    <span class="ledger-orbit ledger-orbit-one"></span>
    <span class="ledger-orbit ledger-orbit-two"></span>
    <span class="ledger-node"><span>✓</span></span>
    <span class="ledger-caption">Signed audit<br />ledger</span>
  </div>

  <div class="security-flow-receipts" aria-hidden="true">
    <span>signed</span><i></i><span>hash</span><i></i><span>proof</span>
  </div>

  <div class="security-flow-output" aria-hidden="true">
    <span class="security-flow-output-mark">▱</span>
    <span>Protected<br />application</span>
  </div>

  <div class="security-flow-threats" aria-hidden="true">
    {threats.map(threat => (
      <span class:list={['security-flow-threat', `security-flow-threat-${threat.placement}`]}><b>×</b>{threat.name}</span>
    ))}
    <span class="threat-fragments fragments-one">· · ·</span>
    <span class="threat-fragments fragments-two">· · ·</span>
    <span class="threat-fragments fragments-three">· · ·</span>
  </div>
</div>

<style>
  .security-flow { --ink: var(--theme-primary); --risk: var(--theme-destructive); position: relative; width: 100%; min-height: 25rem; aspect-ratio: 3 / 2; overflow: hidden; border: 1px solid var(--theme-border); border-radius: 1.5rem; background: color-mix(in oklch, var(--theme-card) 96%, var(--theme-background)); color: var(--theme-foreground); }
  .security-flow-grid { position: absolute; inset: 1rem; opacity: .42; background-image: linear-gradient(to right, color-mix(in oklch, var(--theme-border) 68%, transparent) 1px, transparent 1px), linear-gradient(to bottom, color-mix(in oklch, var(--theme-border) 68%, transparent) 1px, transparent 1px); background-size: 1.75rem 1.75rem; mask-image: linear-gradient(to right, transparent, black 14%, black 86%, transparent); }
  .security-flow-note { position: absolute; top: 5%; left: 6%; margin: 0; color: var(--theme-muted-foreground); font-size: clamp(.58rem, 1.1vw, .74rem); letter-spacing: .01em; }
  .security-flow-lines { position: absolute; inset: 0; width: 100%; height: 100%; }.line { fill: none; stroke-width: 1.45; stroke-linecap: round; stroke-dasharray: 2 8; }.line-safe, .line-output { stroke: color-mix(in oklch, var(--ink) 82%, var(--theme-border)); }.line-output { stroke-width: 1.8; }.line-threat { stroke: color-mix(in oklch, var(--risk) 76%, var(--theme-border)); }.break-mark { fill: none; stroke: var(--risk); stroke-width: 1.5; stroke-linecap: round; }
  .security-flow-sources { position: absolute; inset: 21% auto 16% 6%; display: grid; align-content: space-between; width: 22%; }.security-flow-source { display: flex; align-items: center; gap: .48rem; color: var(--theme-foreground); font-size: clamp(.61rem, 1.15vw, .8rem); font-weight: 650; line-height: 1.1; }.security-flow-source::after { width: 1.5rem; height: 1px; margin-left: .1rem; background: color-mix(in oklch, var(--ink) 55%, transparent); content: ''; }.security-flow-source-mark { display: grid; width: 1.5rem; aspect-ratio: 1; place-items: center; border: 1px solid color-mix(in oklch, var(--ink) 68%, var(--theme-border)); border-radius: 50%; color: var(--ink); font-size: .68rem; font-weight: 800; }
  .security-flow-ledger { position: absolute; top: 50%; left: 54%; width: 25%; aspect-ratio: 1; transform: translate(-50%, -50%); }.ledger-orbit { position: absolute; inset: 9%; border: 1px solid color-mix(in oklch, var(--ink) 72%, var(--theme-border)); border-radius: 50%; }.ledger-orbit-one { transform: rotate(-28deg) scaleY(.52); }.ledger-orbit-two { transform: rotate(54deg) scaleY(.52); opacity: .72; }.ledger-node { position: absolute; inset: 27%; display: grid; place-items: center; border: 1.5px solid var(--ink); border-radius: 50%; background: var(--theme-card); color: var(--ink); box-shadow: 0 0 0 .35rem color-mix(in oklch, var(--ink) 8%, transparent); font-size: clamp(1rem, 2.5vw, 1.75rem); font-weight: 700; }.ledger-node::before, .ledger-node::after { position: absolute; width: .45rem; aspect-ratio: 1; border: 1px solid var(--ink); border-radius: .1rem; background: var(--theme-card); content: ''; }.ledger-node::before { top: -1.45rem; left: 50%; transform: translateX(-50%); }.ledger-node::after { right: -1.45rem; bottom: 50%; transform: translateY(50%); }.ledger-caption { position: absolute; bottom: -8%; left: 50%; width: max-content; transform: translateX(-50%); color: var(--theme-foreground); font-size: clamp(.56rem, 1vw, .72rem); font-weight: 700; line-height: 1.2; text-align: center; }
  .security-flow-receipts { position: absolute; top: 47.5%; left: 64%; display: flex; align-items: center; gap: .38rem; color: var(--ink); font-size: clamp(.49rem, .9vw, .63rem); font-weight: 700; letter-spacing: .02em; }.security-flow-receipts i { width: .28rem; aspect-ratio: 1; border: 1px solid var(--ink); border-radius: 50%; }.security-flow-output { position: absolute; top: 50%; right: 5%; display: flex; width: 14%; min-height: 4.6rem; transform: translateY(-50%); align-items: center; justify-content: center; gap: .35rem; border: 1px solid color-mix(in oklch, var(--ink) 74%, var(--theme-border)); border-radius: .8rem; background: var(--theme-card); color: var(--theme-foreground); font-size: clamp(.57rem, 1vw, .76rem); font-weight: 700; line-height: 1.15; text-align: left; }.security-flow-output-mark { display: grid; width: 1.25rem; aspect-ratio: 1; place-items: center; border: 1px solid var(--ink); border-radius: .2rem; color: var(--ink); font-size: .9rem; }
  .security-flow-threat { position: absolute; display: inline-flex; align-items: center; gap: .28rem; color: color-mix(in oklch, var(--risk) 82%, var(--theme-foreground)); font-size: clamp(.49rem, .95vw, .67rem); font-weight: 650; white-space: nowrap; }.security-flow-threat b { display: grid; width: .93rem; aspect-ratio: 1; place-items: center; border: 1px solid currentColor; border-radius: 50%; font-size: .76rem; font-weight: 700; }.security-flow-threat-prompt { top: 9%; left: 37%; }.security-flow-threat-supply { top: 11%; right: 15%; }.security-flow-threat-agentic { bottom: 9%; left: 45%; }.threat-fragments { position: absolute; color: var(--risk); font-size: .9rem; letter-spacing: .22rem; opacity: .7; }.fragments-one { top: 30%; left: 52%; }.fragments-two { top: 27%; right: 31%; }.fragments-three { bottom: 15%; left: 55%; }
  @media (max-width: 560px) { .security-flow { min-height: 20rem; border-radius: 1.15rem; }.security-flow-note { left: 5%; }.security-flow-sources { left: 4%; width: 28%; }.security-flow-source { gap: .3rem; font-size: .5rem; }.security-flow-source::after { width: .4rem; }.security-flow-source-mark { width: 1.18rem; font-size: .55rem; }.security-flow-ledger { width: 30%; }.security-flow-output { right: 2%; width: 17%; min-height: 4rem; font-size: .48rem; }.security-flow-output-mark, .security-flow-receipts { display: none; }.security-flow-threat { font-size: .42rem; }.security-flow-threat b { width: .7rem; font-size: .6rem; }.security-flow-threat-prompt { left: 34%; }.security-flow-threat-supply { right: 6%; }.security-flow-threat-agentic { left: 41%; } }
</style>
